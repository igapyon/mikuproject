{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miku-project:schema:artifacts:v1",
  "title": "miku-project semantic and exchange artifacts v1",
  "oneOf": [
    { "$ref": "#/$defs/semanticState" },
    { "$ref": "#/$defs/projection" },
    { "$ref": "#/$defs/changeRequest" },
    { "$ref": "#/$defs/semanticDiff" },
    { "$ref": "#/$defs/outputPlan" },
    { "$ref": "#/$defs/changeApproval" },
    { "$ref": "#/$defs/provenance" }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "identity": { "type": "string", "minLength": 1 },
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "localCivilDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "workingDuration": {
      "type": "string",
      "pattern": "^PT[0-9]+H(?:[0-5]?[0-9])M(?:[0-5]?[0-9])S$"
    },
    "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "start", "finish"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "start": { "$ref": "#/$defs/localCivilDateTime" },
        "finish": { "$ref": "#/$defs/localCivilDateTime" },
        "current_date": { "$ref": "#/$defs/localCivilDateTime" },
        "schedule_from_start": { "type": "boolean" },
        "calendar_uid": { "$ref": "#/$defs/identity" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "name",
        "parent_uid",
        "start",
        "finish",
        "duration",
        "milestone",
        "summary",
        "percent_complete"
      ],
      "properties": {
        "uid": { "$ref": "#/$defs/identity" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "parent_uid": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identity" }
          ]
        },
        "start": { "$ref": "#/$defs/localCivilDateTime" },
        "finish": { "$ref": "#/$defs/localCivilDateTime" },
        "duration": { "$ref": "#/$defs/workingDuration" },
        "milestone": { "type": "boolean" },
        "summary": { "type": "boolean" },
        "percent_complete": { "$ref": "#/$defs/percentage" },
        "calendar_uid": { "$ref": "#/$defs/identity" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_uid", "successor_uid", "type", "lag"],
      "properties": {
        "predecessor_uid": { "$ref": "#/$defs/identity" },
        "successor_uid": { "$ref": "#/$defs/identity" },
        "type": { "const": "FS" },
        "lag": { "const": "PT0H0M0S" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": { "$ref": "#/$defs/identity" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "type": { "enum": ["work", "material", "cost"] },
        "calendar_uid": { "$ref": "#/$defs/identity" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "task_uid"],
      "properties": {
        "uid": { "$ref": "#/$defs/identity" },
        "task_uid": { "$ref": "#/$defs/identity" },
        "resource_uid": { "$ref": "#/$defs/identity" },
        "start": { "$ref": "#/$defs/localCivilDateTime" },
        "finish": { "$ref": "#/$defs/localCivilDateTime" },
        "units": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "work": { "$ref": "#/$defs/workingDuration" }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": { "$ref": "#/$defs/identity" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "is_base_calendar": { "type": "boolean" }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "semantic_contract_version",
        "project",
        "tasks",
        "dependencies",
        "resources",
        "assignments",
        "calendars"
      ],
      "properties": {
        "kind": { "const": "miku_project_semantic_state" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "project": { "$ref": "#/$defs/project" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
        "calendars": { "type": "array", "items": { "$ref": "#/$defs/calendar" } }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "before", "after"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "before": {},
        "after": {}
      }
    },
    "lossOrUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "description"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "artifact_digest",
        "manifest_digest",
        "capability_profile",
        "fixture_suite_version"
      ],
      "properties": {
        "family": { "enum": ["node", "java"] },
        "version": { "type": "string", "minLength": 1 },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "capability_profile": { "const": "miku-project-cli-core/v1" },
        "fixture_suite_version": { "const": "1" }
      }
    },
    "projectOverviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_task_uid", "included_domains", "omitted_domains"],
      "properties": {
        "target_task_uid": { "type": "null" },
        "included_domains": {
          "type": "array",
          "prefixItems": [
            { "const": "project" },
            { "const": "tasks" },
            { "const": "dependencies" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "omitted_domains": {
          "type": "array",
          "prefixItems": [
            { "const": "task_edit_details" },
            { "const": "raw_external_artifact" },
            { "const": "unsupported_data" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "taskChangeContextScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_task_uid", "included_domains", "omitted_domains"],
      "properties": {
        "target_task_uid": { "$ref": "#/$defs/identity" },
        "included_domains": {
          "type": "array",
          "prefixItems": [
            { "const": "project" },
            { "const": "target_task" },
            { "const": "ancestors" },
            { "const": "dependencies" },
            { "const": "assignments" },
            { "const": "resources" }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "omitted_domains": {
          "type": "array",
          "prefixItems": [
            { "const": "other_task_details" },
            { "const": "raw_external_artifact" },
            { "const": "unsupported_data" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "projectionCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported_data"],
      "properties": {
        "unsupported_data": {
          "type": "array",
          "items": { "$ref": "#/$defs/lossOrUnsupported" },
          "maxItems": 0
        }
      }
    },
    "overviewTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "name", "parent_uid", "order", "summary", "percent_complete"],
      "properties": {
        "uid": { "$ref": "#/$defs/identity" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "parent_uid": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identity" }
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "summary": { "type": "boolean" },
        "percent_complete": { "$ref": "#/$defs/percentage" }
      }
    },
    "supportedChangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required_preconditions"],
      "properties": {
        "kind": { "const": "set_task_percent_complete" },
        "required_preconditions": {
          "type": "array",
          "prefixItems": [
            { "const": "source_state_digest" },
            { "const": "expected_percent_complete" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "projection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schema_version",
            "semantic_contract_version",
            "purpose",
            "source_state_digest",
            "scope",
            "project",
            "tasks",
            "dependencies",
            "capability"
          ],
          "properties": {
            "kind": { "const": "miku_project_projection" },
            "schema_version": { "const": "1" },
            "semantic_contract_version": { "const": "1" },
            "purpose": { "const": "project_overview" },
            "source_state_digest": { "$ref": "#/$defs/digest" },
            "scope": { "$ref": "#/$defs/projectOverviewScope" },
            "project": { "$ref": "#/$defs/project" },
            "tasks": { "type": "array", "items": { "$ref": "#/$defs/overviewTask" } },
            "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
            "capability": { "$ref": "#/$defs/projectionCapability" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schema_version",
            "semantic_contract_version",
            "purpose",
            "source_state_digest",
            "scope",
            "project",
            "target_task",
            "ancestors",
            "dependencies",
            "resources",
            "assignments",
            "capability",
            "supported_change_requests"
          ],
          "properties": {
            "kind": { "const": "miku_project_projection" },
            "schema_version": { "const": "1" },
            "semantic_contract_version": { "const": "1" },
            "purpose": { "const": "task_change_context" },
            "source_state_digest": { "$ref": "#/$defs/digest" },
            "scope": { "$ref": "#/$defs/taskChangeContextScope" },
            "project": { "$ref": "#/$defs/project" },
            "target_task": { "$ref": "#/$defs/task" },
            "ancestors": { "type": "array", "items": { "$ref": "#/$defs/task" } },
            "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
            "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
            "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
            "capability": { "$ref": "#/$defs/projectionCapability" },
            "supported_change_requests": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/supportedChangeRequest" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "changeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "semantic_contract_version", "base", "operations"],
      "properties": {
        "kind": { "const": "miku_project_change_request" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_digest"],
          "properties": { "state_digest": { "$ref": "#/$defs/digest" } }
        },
        "operations": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "target", "preconditions", "value"],
              "properties": {
                "kind": { "const": "set_task_percent_complete" },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["task_uid"],
                  "properties": { "task_uid": { "$ref": "#/$defs/identity" } }
                },
                "preconditions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expected_percent_complete"],
                  "properties": { "expected_percent_complete": { "$ref": "#/$defs/percentage" } }
                },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["percent_complete"],
                  "properties": { "percent_complete": { "$ref": "#/$defs/percentage" } }
                }
              }
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "semanticDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "semantic_contract_version",
        "base_state_digest",
        "proposed_state_digest",
        "change_request_digest",
        "changes",
        "preservation",
        "provenance"
      ],
      "properties": {
        "kind": { "const": "miku_project_semantic_diff" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "base_state_digest": { "$ref": "#/$defs/digest" },
        "proposed_state_digest": { "$ref": "#/$defs/digest" },
        "change_request_digest": { "$ref": "#/$defs/digest" },
        "changes": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "task_uid", "before", "after"],
              "properties": {
                "kind": { "const": "set_task_percent_complete" },
                "task_uid": { "$ref": "#/$defs/identity" },
                "before": { "$ref": "#/$defs/percentage" },
                "after": { "$ref": "#/$defs/percentage" }
              }
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_equivalent_except_changes"],
          "properties": { "semantic_equivalent_except_changes": { "const": true } }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["losses", "normalizations", "unsupported"],
          "properties": {
            "losses": { "type": "array", "items": { "$ref": "#/$defs/lossOrUnsupported" }, "maxItems": 0 },
            "normalizations": { "type": "array", "items": { "$ref": "#/$defs/normalization" }, "maxItems": 0 },
            "unsupported": { "type": "array", "items": { "$ref": "#/$defs/lossOrUnsupported" }, "maxItems": 0 }
          }
        }
      }
    },
    "outputPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "semantic_contract_version",
        "base_state_digest",
        "change_request_digest",
        "semantic_diff_digest",
        "runtime",
        "output",
        "preflight"
      ],
      "properties": {
        "kind": { "const": "miku_project_output_plan" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "base_state_digest": { "$ref": "#/$defs/digest" },
        "change_request_digest": { "$ref": "#/$defs/digest" },
        "semantic_diff_digest": { "$ref": "#/$defs/digest" },
        "runtime": { "$ref": "#/$defs/runtimeBinding" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "format_profile", "adapter", "artifact_set", "destination", "publication", "members"],
          "properties": {
            "format": { "const": "ms-project-xml" },
            "format_profile": { "const": "miku-project-ms-project-xml-subset/v1" },
            "adapter": { "const": "ms-project-xml-adapter/v1" },
            "artifact_set": { "const": "miku_project_artifact_set/v1" },
            "destination": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "write_mode"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "write_mode": { "const": "create-new-directory" }
              }
            },
            "publication": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy", "directory_create", "commit_marker", "runtime_filesystem_supported"],
              "properties": {
                "strategy": { "const": "exclusive-directory-commit-marker/v1" },
                "directory_create": { "const": "exclusive" },
                "commit_marker": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "create_mode"],
                  "properties": {
                    "path": { "const": "COMMITTED" },
                    "create_mode": { "const": "exclusive-empty-file" }
                  }
                },
                "runtime_filesystem_supported": { "const": true }
              }
            },
            "members": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "path"],
                  "properties": { "role": { "const": "external_project" }, "path": { "const": "project.xml" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "path"],
                  "properties": { "role": { "const": "provenance" }, "path": { "const": "provenance.json" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "path", "size"],
                  "properties": { "role": { "const": "commit_marker" }, "path": { "const": "COMMITTED" }, "size": { "const": 0 } }
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposed_state_digest", "project_artifact_digest", "normalizations", "losses", "unsupported"],
          "properties": {
            "proposed_state_digest": { "$ref": "#/$defs/digest" },
            "project_artifact_digest": { "$ref": "#/$defs/digest" },
            "normalizations": { "type": "array", "items": { "$ref": "#/$defs/normalization" } },
            "losses": { "type": "array", "items": { "$ref": "#/$defs/lossOrUnsupported" }, "maxItems": 0 },
            "unsupported": { "type": "array", "items": { "$ref": "#/$defs/lossOrUnsupported" }, "maxItems": 0 }
          }
        }
      }
    },
    "changeApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "semantic_contract_version",
        "approved",
        "base_state_digest",
        "change_request_digest",
        "semantic_diff_digest",
        "output_plan_digest"
      ],
      "properties": {
        "kind": { "const": "miku_project_change_approval" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "approved": { "const": true },
        "base_state_digest": { "$ref": "#/$defs/digest" },
        "change_request_digest": { "$ref": "#/$defs/digest" },
        "semantic_diff_digest": { "$ref": "#/$defs/digest" },
        "output_plan_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "semantic_contract_version",
        "format_profile",
        "adapter",
        "artifact_set",
        "runtime",
        "input",
        "change",
        "output",
        "transformations",
        "normalizations",
        "losses",
        "unsupported"
      ],
      "properties": {
        "kind": { "const": "miku_project_provenance" },
        "schema_version": { "const": "1" },
        "semantic_contract_version": { "const": "1" },
        "format_profile": { "const": "miku-project-ms-project-xml-subset/v1" },
        "adapter": { "const": "ms-project-xml-adapter/v1" },
        "artifact_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "schema_version", "publication_protocol", "commit_marker"],
          "properties": {
            "kind": { "const": "miku_project_artifact_set" },
            "schema_version": { "const": "1" },
            "publication_protocol": { "const": "exclusive-directory-commit-marker/v1" },
            "commit_marker": { "const": "COMMITTED" }
          }
        },
        "runtime": { "$ref": "#/$defs/runtimeBinding" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "format_profile", "artifact_digest", "state_digest"],
          "properties": {
            "format": { "const": "ms-project-xml" },
            "format_profile": { "const": "miku-project-ms-project-xml-subset/v1" },
            "artifact_digest": { "$ref": "#/$defs/digest" },
            "state_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_request_digest", "semantic_diff_digest", "output_plan_digest", "target_task_uid", "before_percent_complete", "after_percent_complete"],
          "properties": {
            "change_request_digest": { "$ref": "#/$defs/digest" },
            "semantic_diff_digest": { "$ref": "#/$defs/digest" },
            "output_plan_digest": { "$ref": "#/$defs/digest" },
            "target_task_uid": { "$ref": "#/$defs/identity" },
            "before_percent_complete": { "$ref": "#/$defs/percentage" },
            "after_percent_complete": { "$ref": "#/$defs/percentage" }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "format_profile", "path", "artifact_digest", "state_digest"],
          "properties": {
            "format": { "const": "ms-project-xml" },
            "format_profile": { "const": "miku-project-ms-project-xml-subset/v1" },
            "path": { "const": "project.xml" },
            "artifact_digest": { "$ref": "#/$defs/digest" },
            "state_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "transformations": {
          "type": "array",
          "prefixItems": [
            { "const": "decode" },
            { "const": "validate" },
            { "const": "dry-run-apply" },
            { "const": "diff" },
            { "const": "preflight-encode" },
            { "const": "preflight-redecode" },
            { "const": "approval-check" },
